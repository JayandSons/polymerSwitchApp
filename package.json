{
  "name": "kanban-agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "src",
    "web-ui"
  ],
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,green \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/cli.ts --port 3100 --no-open",
    "dev:ui": "npm run dev --workspace=web-ui",
    "build:ui": "npm run build --workspace=web-ui",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --build && tsc -p web-ui/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
